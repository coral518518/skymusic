<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calibrateOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 15键光圈绘制层 (全透明镂空绘制，无多余底色遮罩) -->
    <com.skymusic.player.ui.KeyVisualizerView
        android:id="@+id/keyVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部提示文字：精巧半透明胶囊 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_floating_panel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:elevation="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="校准模式：黄圈=琴键范围 · 蓝圈=防检测随机点击范围"
            android:textColor="@color/sky_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部校准调节工具条：小巧紧凑半透明底栏 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_panel"
        android:padding="8dp"
        android:elevation="10dp">

        <!-- 调节控制器：微调位置与缩放 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnCalibrateMoveLeft"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="←"
                android:textSize="14sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke" />

            <Button
                android:id="@+id/btnCalibrateMoveRight"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="→"
                android:textSize="14sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke"
                android:layout_marginStart="3dp" />

            <Button
                android:id="@+id/btnCalibrateMoveUp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="↑"
                android:textSize="14sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke"
                android:layout_marginStart="6dp" />

            <Button
                android:id="@+id/btnCalibrateMoveDown"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="↓"
                android:textSize="14sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke"
                android:layout_marginStart="3dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="@color/sky_card_dark_stroke"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="缩放:"
                android:textColor="@color/sky_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCalibrateZoomOut"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="-"
                android:textSize="15sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke"
                android:layout_marginStart="3dp" />

            <Button
                android:id="@+id/btnCalibrateZoomIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="15sp"
                android:textColor="@color/sky_text_primary"
                app:strokeColor="@color/sky_card_dark_stroke"
                android:layout_marginStart="3dp" />
        </LinearLayout>

        <!-- 底部快捷操作：自适应、重置、完成 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCalibrateAutoFit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="一键对齐"
                android:textSize="11sp"
                android:textColor="@color/sky_accent"
                app:strokeColor="@color/sky_accent"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/btnCalibrateReset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="重置"
                android:textSize="11sp"
                android:textColor="@color/sky_text_secondary"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnCalibrateDone"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="保存完成"
                android:textSize="11sp"
                android:textColor="#000000"
                android:backgroundTint="@color/sky_primary"
                app:cornerRadius="15dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
