<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingControlRoot"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_panel"
    android:padding="8dp"
    android:elevation="12dp">

    <!-- 1. 顶部标题栏 (可拖动移动整块面板) -->
    <LinearLayout
        android:id="@+id/llFloatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_floating_note"
            app:tint="@color/sky_primary" />

        <TextView
            android:id="@+id/tvFloatSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="请选择曲目"
            android:textColor="@color/sky_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/btnFloatCalibrate"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tune"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_accent"
            android:padding="3dp"
            android:contentDescription="校准" />

        <ImageButton
            android:id="@+id/btnFloatMinimize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_stop"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary"
            android:padding="3dp"
            android:layout_marginStart="2dp"
            android:contentDescription="收起" />
    </LinearLayout>

    <!-- 2. 微型进度条与时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvFloatCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/sky_text_hint"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/sbFloatProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:maxHeight="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:progressTint="@color/sky_primary"
            android:thumbTint="@color/sky_primary" />

        <TextView
            android:id="@+id/tvFloatTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/sky_text_hint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. 核心播放控制与快捷选歌行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageButton
            android:id="@+id/btnFloatPrev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_play_arrow"
            android:rotation="180"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary" />

        <ImageButton
            android:id="@+id/btnFloatPlayPause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_floating_ball"
            android:padding="6dp"
            app:tint="#1E293B"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnFloatNext"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_play_arrow"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnFloatSelectSong"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="选歌"
            android:textSize="11sp"
            android:textColor="@color/sky_text_primary"
            app:strokeColor="@color/sky_card_dark_stroke"
            app:cornerRadius="13dp" />

        <Button
            android:id="@+id/btnFloatHideAll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="退出"
            android:textSize="11sp"
            android:textColor="@color/sky_text_secondary"
            app:strokeColor="@color/sky_card_dark_stroke"
            app:cornerRadius="13dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 4. 速度与移调紧凑合并行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="速"
            android:textColor="@color/sky_text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFloatSpeedSlow"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/sky_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFloatSpeedVal"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:gravity="center"
            android:textColor="@color/sky_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatSpeedFast"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/sky_text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="@color/sky_card_dark_stroke"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="调"
            android:textColor="@color/sky_text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnFloatPitchDown"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/sky_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFloatPitchVal"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:gravity="center"
            android:textColor="@color/sky_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFloatPitchUp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/sky_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
