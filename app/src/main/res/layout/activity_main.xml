<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 顶部 Header 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/sky_primary"
                    android:background="@drawable/bg_floating_ball"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_dashboard"
                        android:textColor="@color/sky_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_dashboard"
                        android:textColor="@color/sky_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0"
                    android:textColor="@color/sky_text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 权限状态卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sky_card_dark"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_header"
                        android:textColor="@color/sky_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Root 底层触控模式 (防游戏检测) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Root 底层触控 (推荐·防检测)"
                                android:textColor="@color/sky_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRootStatusDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KernelSU / APatch / Magisk 底层注入，免无障碍"
                                android:textColor="@color/sky_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnRootPerm"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="开启Root"
                            android:textSize="12sp"
                            android:textColor="#000"
                            android:backgroundTint="@color/sky_accent"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sky_card_dark_stroke"
                        android:layout_marginBottom="12dp" />

                    <!-- 无障碍权限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/permission_accessibility_title"
                                android:textColor="@color/sky_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/permission_accessibility_desc"
                                android:textColor="@color/sky_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnAccessibilityPerm"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_enable"
                            android:textSize="12sp"
                            android:textColor="#000"
                            android:backgroundTint="@color/sky_primary"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sky_card_dark_stroke"
                        android:layout_marginBottom="12dp" />

                    <!-- 悬浮窗权限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/permission_float_title"
                                android:textColor="@color/sky_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/permission_float_desc"
                                android:textColor="@color/sky_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnFloatPerm"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_enable"
                            android:textSize="12sp"
                            android:textColor="#000"
                            android:backgroundTint="@color/sky_primary"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 悬浮窗启动控制大按钮 -->
            <Button
                android:id="@+id/btnToggleFloating"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/start_floating_service"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/bg_button_gold"
                android:layout_marginBottom="20dp"
                app:backgroundTint="@null" />

            <!-- 乐谱库与导入控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="乐谱曲库"
                    android:textColor="@color/sky_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnImportSheet"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ 导入乐谱"
                    android:textSize="12sp"
                    android:textColor="@color/sky_accent"
                    app:strokeColor="@color/sky_accent"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- 乐谱分类过滤标签 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                app:tabTextColor="@color/sky_text_secondary"
                app:tabSelectedTextColor="@color/sky_primary"
                app:tabIndicatorColor="@color/sky_primary"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                android:layout_marginBottom="10dp">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="精选预设" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的导入" />
            </com.google.android.material.tabs.TabLayout>

            <!-- 乐谱列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSongList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp" />

            <!-- 屏幕分辨率适配与使用指引卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sky_card_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 使用指南与按键校准提示"
                        android:textColor="@color/sky_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. 开启无障碍与悬浮窗权限后，点击上方「启动游戏悬浮窗」。\n2. 打开《光遇》游戏，拿出乐器（钢琴、竖琴等）。\n3. 点击悬浮窗的「校准」按钮，屏幕会浮现 15 个半透明光圈。\n4. 点击「自动适配」或拖动微调滑块让光圈对准光遇琴键。\n5. 选择曲目点击「播放」，即刻开始自动演奏！"
                        android:textColor="@color/sky_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:id="@+id/tvScreenInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前屏幕分辨率检测中..."
                        android:textColor="@color/sky_accent"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
