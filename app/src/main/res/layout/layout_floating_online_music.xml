<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llFloatingOnlineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_panel"
    android:padding="8dp"
    android:elevation="16dp">

    <!-- 1. 顶部标题与网页控制栏 (可按住拖动浮窗整体位置) -->
    <LinearLayout
        android:id="@+id/llOnlineHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_floating_note"
            app:tint="@color/sky_accent" />

        <TextView
            android:id="@+id/tvOnlineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音游伴侣 · 官方曲库"
            android:textColor="@color/sky_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />

        <!-- 网页导航与操作按钮 -->
        <ImageButton
            android:id="@+id/btnWebBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary"
            android:padding="5dp"
            android:contentDescription="后退" />

        <ImageButton
            android:id="@+id/btnWebForward"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary"
            android:padding="5dp"
            android:contentDescription="前进" />

        <ImageButton
            android:id="@+id/btnWebRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary"
            android:padding="5dp"
            android:contentDescription="刷新" />

        <ImageButton
            android:id="@+id/btnWebHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_primary"
            android:padding="5dp"
            android:contentDescription="曲库首页" />

        <ImageButton
            android:id="@+id/btnOnlineClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/sky_text_secondary"
            android:padding="5dp"
            android:layout_marginStart="2dp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 加载进度指示条 -->
    <ProgressBar
        android:id="@+id/pbWebLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:progressTint="@color/sky_primary"
        android:visibility="gone" />

    <!-- 2. WebView 主体内容 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <WebView
            android:id="@+id/wvOnlineMusic"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
