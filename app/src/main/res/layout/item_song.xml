<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSongItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/sky_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivSongIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_music_note"
            android:background="@drawable/bg_key_circle"
            android:padding="8dp"
            app:tint="@color/sky_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="曲目名称"
                android:textColor="@color/sky_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvSongMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="240 音符 · 1:35 · 120 BPM"
                    android:textColor="@color/sky_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSongTypeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIDI"
                    android:textColor="@color/sky_accent"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:background="#2280D8FF"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQuickPlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_floating_ball"
            android:padding="6dp"
            app:tint="#000" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
