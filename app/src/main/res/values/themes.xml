<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SkyMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sky_primary</item>
        <item name="colorPrimaryVariant">@color/sky_primary_dark</item>
        <item name="colorOnPrimary">#000000</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/sky_accent</item>
        <item name="colorSecondaryVariant">@color/sky_accent</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/sky_bg_dark</item>
        <item name="android:navigationBarColor">@color/sky_bg_dark</item>
        <item name="android:windowBackground">@color/sky_bg_dark</item>
    </style>
</resources>
